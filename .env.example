# Utilisé uniquement par scripts/sync-chatbot.js (Node, local/CI). Ne jamais
# préfixer par VITE_ : ça les embarquerait dans le bundle navigateur.
# Copiez ce fichier en .env.local et renseignez-y vos valeurs (jamais commitées).

CHATBOT_API_URL=http://localhost:8000
CONTENT_UPLOAD_TOKEN=

# Utilisé par le widget chatbot côté navigateur (src/api/chatApi.js) pour
# appeler POST /chatbot — distinct de CHATBOT_API_URL ci-dessus. Le préfixe
# VITE_ est sans risque ici : /chatbot est l'API publique du backend (aucun
# secret). Si absente, chatApi.js retombe sur l'URL de production actuelle.
VITE_CHATBOT_API_URL=http://localhost:8000
